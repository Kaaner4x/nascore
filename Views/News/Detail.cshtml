@model Nascore.ViewModels.NewsDetailViewModel
@{
    ViewData["Title"] = Model.CurrentNews.Title;
}

<!-- Sayfa Başlığı Start -->
<section class="page-title section pt-5 pb-0">
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <div class="text-center">
          <h1 class="text-capitalize mb-0 text-lg">Haber Detayı</h1>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- Sayfa Başlığı End -->

<section class="section blog-post pt-4">
	<div class="container">
		<div class="row">
			<div class="col-lg-8">
				<article class="single-post">
					<img src="@Model.CurrentNews.ImageUrl" alt="@Model.CurrentNews.Title" class="img-fluid w-100 rounded">

					<div class="single-post-content mt-4">
						<div class="post-meta mb-4">
							<span class="text-black font-weight-bold">Kategori :</span>
							<span class="text-color">@Model.CurrentNews.Category</span>
							<span class="mx-3">•</span>
							<span class="date text-muted"><i class="ti-calendar mr-1"></i>@Model.CurrentNews.PublishedDate.ToString("dd MMMM yyyy")</span>
						</div>
						
						<h3 class="mb-3">@Model.CurrentNews.Title</h3>

						<div class="lead-text mb-4">
                            @Html.Raw(Model.CurrentNews.Content)
                        </div>

						<!-- Paylaşım Bölümü -->
						<div class="share mt-5 pt-4 border-top">
							<ul class="list-inline d-flex align-items-center mb-0">
								<li class="mr-3 font-weight-bold text-dark">Paylaş:</li>
								<li class="list-inline-item mr-3"><a href="https://facebook.com" target="_blank" class="text-muted"><i class="ti-facebook mr-1"></i> Facebook</a></li>
								<li class="list-inline-item mr-3"><a href="https://twitter.com" target="_blank" class="text-muted"><i class="ti-twitter mr-1"></i> Twitter</a></li>
								<li class="list-inline-item mr-3"><a href="https://linkedin.com" target="_blank" class="text-muted"><i class="ti-linkedin mr-1"></i> LinkedIn</a></li>
								<li class="list-inline-item"><a href="https://pinterest.com" target="_blank" class="text-muted"><i class="ti-pinterest mr-1"></i> Pinterest</a></li>
							</ul>
						</div>	
					</div>
				</article>
			</div>

			<!-- Sağ Kenar Çubuğu (Sidebar) -->
			<div class="col-lg-4">
				<div class="sidebar-widget mt-5 mt-lg-0">
					<!-- Bizi Takip Edin -->
					<div class="widget mb-5 follow">
						<h4 class="mb-4 widget-title">Bizi Takip Edin</h4>
						<ul class="list-inline mb-0">
							<li class="list-inline-item"><a href="https://facebook.com" target="_blank"><i class="ti-facebook"></i></a></li>
							<li class="list-inline-item"><a href="https://twitter.com" target="_blank"><i class="ti-twitter"></i></a></li>
							<li class="list-inline-item"><a href="https://github.com" target="_blank"><i class="ti-github"></i></a></li>
							<li class="list-inline-item"><a href="https://linkedin.com" target="_blank"><i class="ti-linkedin"></i></a></li>
							<li class="list-inline-item"><a href="https://pinterest.com" target="_blank"><i class="ti-pinterest"></i></a></li>
							<li class="list-inline-item"><a href="https://dribbble.com" target="_blank"><i class="ti-dribbble"></i></a></li>
						</ul>
					</div>

					<!-- İlgili Haberler -->
					<div class="widget mb-5">
						<h4 class="mb-4 widget-title">İlgili Haberler</h4>
						<ul class="list-unstyled mb-0">
                            @foreach (var related in Model.RelatedNews)
                            {
							    <li class="d-flex mb-4 align-items-center">
								    <img src="@related.ImageUrl" alt="@related.Title" class="img-fluid mr-3 popular-post-img">
								    <div class="post-body">
									    <span class="text-muted d-block text-sm"><i class="ti-calendar mr-1"></i>@related.PublishedDate.ToString("dd MMMM yyyy")</span>
									    <a asp-controller="News" asp-action="Detail" asp-route-id="@related.Id">
										    <h5>@related.Title</h5>
									    </a>
								    </div>
							    </li>
                            }
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
