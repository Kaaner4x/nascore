@model Nascore.ViewModels.ProjectViewModel
@{
    ViewData["Title"] = "Projelerimiz";
}

<section class="section banner pt-5 pb-4">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-lg-8 text-center">
				<h2><span class="text-color">@Model.BannerTitlePart1</span> @Model.BannerTitlePart2 <br>@Model.BannerDescription</h2>
			</div>
		</div>
	</div>
</section>

<section class="portfolio pt-4">
	<div class="container">
		<div class="row mb-5 justify-content-center">
	      	<div class="col-10 text-center">
		        <div class="btn-group btn-group-toggle " data-toggle="buttons">
		          <label class="btn active ">
		            <input type="radio" name="shuffle-filter" value="all" checked="" />Tüm Projeler
		          </label>
                  @foreach(var cat in Model.Categories)
                  {
		            <label class="btn">
		                <input type="radio" name="shuffle-filter" value="@cat.FilterValue" />@cat.Name
		            </label>
                  }
		        </div>
	      	</div>
    	</div>	

		<div class="row shuffle-wrapper portfolio-gallery">
          @foreach(var project in Model.Projects)
          {
              var groups = string.Join("&quot;,&quot;", project.FilterGroups);
              groups = "[&quot;" + groups + "&quot;]";
              
	          <div class="col-lg-4 col-6 mb-4 shuffle-item" data-groups="@Html.Raw(groups)">
		      	  <div class="position-relative inner-box">
		              <div class="image position-relative ">
	                  <img src="@project.ImageUrl" alt="@project.Title" class="img-fluid w-100 d-block">
	                   <a class="overlay-box" asp-controller="Project" asp-action="Detail" asp-route-id="@project.Id">
	                     <div class="overlay-inner">
	                       <div class="overlay-content">
	                         <h5 class="mb-0 ">@project.Title</h5>
	                         <p>@project.SubTitle</p>
	                       </div>
	                     </div> 
	                   </a>
	               </div>
		         </div>
	         </div>
          }
	    </div>

        @if(Model.TotalPages > 1) 
        {
            <div class="row mt-5">
                <div class="col-lg-12">
                    <div class="pagination text-center">
                        <ul class="list-inline d-block mx-auto mb-0">
                            @if(Model.CurrentPage > 1)
                            {
                                <li class="list-inline-item">
                                    <a asp-controller="Project" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">Önceki</a>
                                </li>
                            }
                            
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="list-inline-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a asp-controller="Project" asp-action="Index" asp-route-page="@i"><span>@i</span></a>
                                </li>
                            }

                            @if(Model.CurrentPage < Model.TotalPages)
                            {
                                <li class="list-inline-item">
                                    <a asp-controller="Project" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">Sonraki</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

	</div>
</section>
