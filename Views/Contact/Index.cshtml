@inject Nascore.Services.Abstract.ISiteSettingService SiteSettings
@model Nascore.ViewModels.ContactViewModel
@{
    ViewData["Title"] = "İletişim";
}

<!-- Banner / Page Header Start -->
<section class="section banner pt-5 pb-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center" data-aos="fade-up">
                <h1 class="h2"><span class="text-color">@Model.BannerTitlePart1</span> @Model.BannerTitlePart2</h1>
                <p class="lead-text mt-3 mb-0">@Model.BannerDescription</p>
            </div>
        </div>
    </div>
</section>
<!-- Banner / Page Header End -->

<!-- Contact Section Start -->
<section class="section contact-section pt-4 pb-5">
    <div class="container">
        <div class="row">
            <!-- Sol Taraf: İletişim Bilgileri & Harita -->
            <div class="col-lg-5 col-md-12 mb-5 mb-lg-0 d-flex flex-column" data-aos="fade-right">
                <div class="contact-info-card d-flex flex-column h-100">
                    <h2 class="contact-card-title mb-3">İletişim Bilgileri</h2>
                    <p class="contact-card-desc mb-4">Ofisimize uğrayabilir veya iletişim kanallarımızdan bize dilediğiniz an ulaşabilirsiniz.</p>

                    <div class="contact-info-list mb-4">
                        <div class="contact-info-item d-flex align-items-start mb-4">
                            <div class="contact-icon-box mr-3">
                                <i class="ti-location-pin" aria-hidden="true"></i>
                            </div>
                            <div>
                                <h3 class="contact-info-heading mb-1">Adresimiz</h3>
                                <p class="mb-0 text-muted">@Model.Address</p>
                            </div>
                        </div>

                        <div class="contact-info-item d-flex align-items-start mb-4">
                            <div class="contact-icon-box mr-3">
                                <i class="ti-mobile" aria-hidden="true"></i>
                            </div>
                            <div>
                                <h3 class="contact-info-heading mb-1">Telefon Numarası</h3>
                                <p class="mb-0"><a href="tel:@Model.Phone.Replace(" ", "").Replace("(", "").Replace(")", "")" class="contact-link">@Model.Phone</a></p>
                            </div>
                        </div>

                        <div class="contact-info-item d-flex align-items-start mb-4">
                            <div class="contact-icon-box mr-3">
                                <i class="ti-email" aria-hidden="true"></i>
                            </div>
                            <div>
                                <h3 class="contact-info-heading mb-1">E-Posta Adresi</h3>
                                <p class="mb-0"><a href="mailto:@Model.Email" class="contact-link">@Model.Email</a></p>
                            </div>
                        </div>

                        <div class="contact-info-item d-flex align-items-start mb-4">
                            <div class="contact-icon-box mr-3">
                                <i class="ti-time" aria-hidden="true"></i>
                            </div>
                            <div>
                                <h3 class="contact-info-heading mb-1">Çalışma Saatleri</h3>
                                <p class="mb-0 text-muted">@Model.WorkingHours</p>
                            </div>
                        </div>
                    </div>

                    <!-- Harita -->
                    <div class="contact-map-wrapper mt-auto">
                        <iframe 
                            src="@Model.GoogleMapsUrl" 
                            width="100%" 
                            height="230" 
                            title="Nascore Ofis Lokasyonu Google Haritası"
                            style="border:0;" 
                            allowfullscreen="" 
                            loading="lazy" 
                            referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </div>
            </div>

            <!-- Sağ Taraf: Mesaj Gönderme Formu -->
            <div class="col-lg-7 col-md-12" data-aos="fade-left">
                <div class="contact-form-card">
                    <h2 class="contact-card-title mb-2">Bize Mesaj Gönderin</h2>
                    <p class="contact-card-desc mb-4">Aşağıdaki formu doldurarak bize projeniz hakkında bilgi verebilirsiniz. En kısa sürede sizinle iletişime geçeceğiz.</p>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div id="contact-alert-success" class="alert alert-success alert-dismissible fade show mb-4" role="alert" aria-live="polite">
                            <i class="ti-check mr-2" aria-hidden="true"></i> <strong>Teşekkürler!</strong> @TempData["SuccessMessage"]
                            <button type="button" class="close" data-dismiss="alert" aria-label="Kapat">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    }

                    <form asp-controller="Contact" asp-action="Index" method="post" id="contact-form" novalidate>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-4">
                                <label asp-for="Form.Name" class="contact-form-label">Adınız Soyadınız <span class="text-danger" aria-hidden="true">*</span></label>
                                <div class="input-with-icon">
                                    <i class="ti-user form-icon" aria-hidden="true"></i>
                                    <input asp-for="Form.Name" class="form-control contact-form-control" placeholder="Örn: Ahmet Yılmaz" autocomplete="name" required>
                                </div>
                                <span asp-validation-for="Form.Name" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6 mb-4">
                                <label asp-for="Form.Email" class="contact-form-label">E-Posta Adresiniz <span class="text-danger" aria-hidden="true">*</span></label>
                                <div class="input-with-icon">
                                    <i class="ti-email form-icon" aria-hidden="true"></i>
                                    <input asp-for="Form.Email" type="email" class="form-control contact-form-control" placeholder="Örn: ahmet@nascore.com" autocomplete="email" required>
                                </div>
                                <span asp-validation-for="Form.Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6 mb-4">
                                <label asp-for="Form.Phone" class="contact-form-label">Telefon Numaranız</label>
                                <div class="input-with-icon">
                                    <i class="ti-mobile form-icon" aria-hidden="true"></i>
                                    <input asp-for="Form.Phone" type="tel" class="form-control contact-form-control" placeholder="Örn: +90 (5XX) XXX XX XX" autocomplete="tel">
                                </div>
                                <span asp-validation-for="Form.Phone" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6 mb-4">
                                <label asp-for="Form.Subject" class="contact-form-label">Konu <span class="text-danger" aria-hidden="true">*</span></label>
                                <div class="input-with-icon">
                                    <i class="ti-pencil-alt form-icon" aria-hidden="true"></i>
                                    <input asp-for="Form.Subject" class="form-control contact-form-control" placeholder="Örn: Yeni Web Sitesi & Marka Kimliği" required>
                                </div>
                                <span asp-validation-for="Form.Subject" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Form.Message" class="contact-form-label">Mesajınız <span class="text-danger" aria-hidden="true">*</span></label>
                            <div class="input-with-icon">
                                <i class="ti-comment-alt form-icon textarea-icon" aria-hidden="true"></i>
                                <textarea asp-for="Form.Message" class="form-control contact-form-control contact-textarea" rows="7" placeholder="Projeniz veya iletmek istediğiniz detayları buraya yazabilirsiniz..." required></textarea>
                            </div>
                            <span asp-validation-for="Form.Message" class="text-danger"></span>
                        </div>

                        <!-- KVKK Aydınlatma Metni Onayı -->
                        <div class="custom-control custom-checkbox mb-4">
                            <input asp-for="Form.IsKvkkAccepted" type="checkbox" class="custom-control-input" id="contact-kvkk" required>
                            <label class="custom-control-label text-sm text-muted" for="contact-kvkk">
                                İletişim formundaki kişisel verilerimin Nascore Gizlilik ve Aydınlatma Metni kapsamında işlenmesini kabul ediyorum. <span class="text-danger" aria-hidden="true">*</span>
                            </label>
                            <span asp-validation-for="Form.IsKvkkAccepted" class="text-danger d-block"></span>
                        </div>

                        <div class="contact-submit-wrapper text-center mt-3">
                            <button type="submit" id="btn-contact-submit" class="btn btn-hero-primary contact-submit-btn w-100">
                                <span id="btn-contact-text">Mesajı Gönder</span> <i class="ti-arrow-right ml-2" id="btn-contact-icon" aria-hidden="true"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Contact Section End -->