@model Nascore.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
}

<!-- Banner Start -->
<section class="section banner pb-4">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1 class="cd-headline clip is-full-width mb-4">
                    Markanız İçin <br>
                    <span class="cd-words-wrapper text-color" aria-live="polite">
                        <b class="is-visible">Tasarım Çözümleri.</b>
                        <b>Yaratıcı Fikirler.</b>
                        <b>Dijital Deneyimler.</b>
                        <b>Profesyonel İçerikler.</b>
                    </span>
                </h1>
                <p class="lead-text mb-4">Modern web teknolojileri ve özgün tasarım anlayışıyla işletmenizin dijital dünyadaki varlığını güçlendiriyor, markanızı hedef kitlenizle en etkili şekilde buluşturuyoruz.</p>
                <div class="banner-buttons d-flex flex-wrap align-items-center">
                    <a asp-controller="Project" asp-action="Index" class="btn btn-hero-primary mr-3 mb-2">
                        Projelerimizi İnceleyin <i class="ti-arrow-right ml-2" aria-hidden="true"></i>
                    </a>
                    <a asp-controller="Contact" asp-action="Index" class="btn btn-hero-secondary mb-2">
                        İletişime Geçin
                    </a>
                </div>
            </div>

            <!-- Sağ Taraftaki Öne Çıkan Görsel / İllüstrasyon -->
            <div class="col-lg-5 mt-5 mt-lg-0 text-center">
                <div class="hero-image-wrapper">
                    <img src="~/user-interface/images/home-2.webp" width="480" height="380" fetchpriority="high" alt="Nascore Dijital Tasarım ve Web Teknolojileri" class="img-fluid hero-img">
                    <div class="hero-floating-badge">
                        <div class="badge-icon">
                            <i class="ti-check" aria-hidden="true"></i>
                        </div>
                        <div class="badge-text">
                            <span class="font-weight-bold d-block">%100</span>
                            <span class="text-muted text-sm">Müşteri Memnuniyeti</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Banner End -->

<!-- Haberler Listesi Start -->
<section class="section blog-list pt-4 pb-5">
    <div class="container">
        <!-- Section Header -->
        <div class="row mb-5">
            <div class="col-12 text-center">
                <h2 class="mb-2">Güncel Haberler ve Duyurular</h2>
                <p>Sektörel gelişmeler, yeni projelerimiz ve teknoloji trendleri hakkında en güncel yazılarımız.</p>
            </div>
        </div>

        <div class="row">
            <!-- Sol Ana Sütun (Son Haberler - Kart Yapısı) -->
            <div class="col-lg-8">
                <div class="row">
                    @foreach (var newsItem in Model.LatestNews)
                    {
                        <div class="col-md-6 mb-5">
                            <article class="blog-post-card h-100 d-flex flex-column">
                                <div class="post-image-wrapper mb-3 overflow-hidden rounded">
                                    <a asp-controller="News" asp-action="Detail" asp-route-id="@newsItem.Id">
                                        <img src="@newsItem.ImageUrl" alt="@newsItem.Title" class="img-fluid w-100 post-image" loading="lazy" decoding="async">
                                    </a>
                                </div>
                                <div class="post-content-wrapper d-flex flex-column flex-grow-1">
                                    <div class="post-meta mb-2 d-flex align-items-center text-muted text-sm">
                                        <span class="post-category text-color font-weight-bold mr-3">@newsItem.Category</span>
                                        <span class="post-date"><i class="ti-calendar mr-1" aria-hidden="true"></i>@newsItem.PublishedDate.ToString("dd MMMM yyyy")</span>
                                    </div>
                                    <a asp-controller="News" asp-action="Detail" asp-route-id="@newsItem.Id" class="post-title-link">
                                        <h3 class="h4 mb-3">@newsItem.Title</h3>
                                    </a>
                                    <a asp-controller="News" asp-action="Detail" asp-route-id="@newsItem.Id" class="read-more-link mt-auto font-weight-bold">
                                        Devamını Oku <i class="ti-angle-right ml-1" aria-hidden="true"></i>
                                    </a>
                                </div>
                            </article>
                        </div>
                    }
                </div>
                
                <!-- Sayfalama (Pagination) Alanı -->
                @if (Model.TotalPages > 1)
                {
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="pagination text-center">
                                <ul class="list-inline d-block mx-auto mb-0">
                                    @if (Model.CurrentPage > 1)
                                    {
                                        <li class="list-inline-item">
                                            <a asp-controller="Home" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">Önceki</a>
                                        </li>
                                    }
                                    
                                    @for (int i = 1; i <= Model.TotalPages; i++)
                                    {
                                        <li class="list-inline-item @(i == Model.CurrentPage ? "active" : "")">
                                            <a asp-controller="Home" asp-action="Index" asp-route-page="@i"><span>@i</span></a>
                                        </li>
                                    }

                                    @if (Model.CurrentPage < Model.TotalPages)
                                    {
                                        <li class="list-inline-item">
                                            <a asp-controller="Home" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">Sonraki</a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Sağ Sütun (Sidebar) -->
            <div class="col-lg-4">
                <div class="sidebar-widget pl-lg-4 mt-5 mt-lg-0">
                    <!-- Bizi Takip Edin Widget -->
                    <div class="widget mb-5 follow-widget">
                        <h4 class="mb-4 widget-title">Bizi Takip Edin</h4>
                        <ul class="list-inline mb-0 social-links">
                            <li class="list-inline-item"><a href="#!" aria-label="Facebook Sayfası"><i class="ti-facebook" aria-hidden="true"></i></a></li>
                            <li class="list-inline-item"><a href="#!" aria-label="Twitter Profili"><i class="ti-twitter" aria-hidden="true"></i></a></li>
                            <li class="list-inline-item"><a href="#!" aria-label="GitHub Profili"><i class="ti-github" aria-hidden="true"></i></a></li>
                            <li class="list-inline-item"><a href="#!" aria-label="LinkedIn Profili"><i class="ti-linkedin" aria-hidden="true"></i></a></li>
                            <li class="list-inline-item"><a href="#!" aria-label="Pinterest Profili"><i class="ti-pinterest" aria-hidden="true"></i></a></li>
                            <li class="list-inline-item"><a href="#!" aria-label="Dribbble Profili"><i class="ti-dribbble" aria-hidden="true"></i></a></li>
                        </ul>
                    </div>

                    <!-- Popüler Haberler Widget (Liste Yapısı) -->
                    <div class="widget mb-5 popular-posts-widget">
                        <h4 class="mb-4 widget-title">Popüler Haberler</h4>
                        <ul class="list-unstyled mb-0">
                            @foreach (var popular in Model.PopularNews)
                            {
                                <li class="d-flex mb-4 align-items-center">
                                    <img src="@popular.ImageUrl" alt="@popular.Title" class="img-fluid mr-3 popular-post-img" loading="lazy" decoding="async">
                                    <div class="post-body">
                                        <span class="text-muted d-block text-sm"><i class="ti-calendar mr-1" aria-hidden="true"></i>@popular.PublishedDate.ToString("dd MMMM yyyy")</span>
                                        <a asp-controller="News" asp-action="Detail" asp-route-id="@popular.Id">
                                            <h4 class="h5">@popular.Title</h4>
                                        </a>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>
<!-- Haberler Listesi End -->
