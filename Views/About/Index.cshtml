@model Nascore.ViewModels.AboutViewModel
@{
    ViewData["Title"] = "Hakkımızda";
}

<!-- Banner Start -->
<section class="section banner-about pb-4">
    <div class="container">
        <div class="row">
            <div class="col-lg-10">
                <h1 class="cd-headline clip is-full-width mb-4">
                    @Model.BannerTitlePart1 <br>
                    <span class="cd-words-wrapper text-color" aria-live="polite">
                        @for (int i = 0; i < Model.BannerDynamicWords.Count; i++)
                        {
                            <b class="@(i == 0 ? "is-visible" : "")">@Model.BannerDynamicWords[i]</b>
                        }
                    </span>
                    <br>@Model.BannerTitlePart2
                </h1>
                <p class="mb-5 lead-text">@Html.Raw(Model.BannerDescription)</p>
            </div>
        </div>

        <div class="row">
            @{ var featureDelay = 0; }
            @foreach (var feature in Model.BannerFeatures)
            {
                <div class="col-lg-4 col-md-6 mb-4" data-aos="fade-up" @(featureDelay > 0 ? $"data-aos-delay=\"{featureDelay}\"" : "")>
                    <h3 class="h4">@feature.Title</h3>
                    <p>@feature.Description</p>
                </div>
                featureDelay += 150;
            }
        </div>
    </div>
</section>
<!-- Banner End -->

<!-- Service start -->
<section class="section service-home border-top">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <h2 class="mb-2">@Model.ServicesTitle</h2>
                <p class="mb-5">@Model.ServicesDescription</p>
            </div>
        </div>

        <div class="row">
            @{ var serviceDelay = 0; }
            @foreach (var service in Model.Services)
            {
                <div class="col-lg-4 col-md-6 mb-5">
                    <div class="service-item" data-aos="fade-up" @(serviceDelay > 0 ? $"data-aos-delay=\"{serviceDelay}\"" : "")>
                        <i class="@service.IconClass" aria-hidden="true"></i>
                        <div class="service-content">
                            <h3 class="h4 mb-3">@service.Title</h3>
                            <p class="mb-0">@service.Description</p>
                        </div>
                    </div>
                </div>
                serviceDelay = (serviceDelay == 200) ? 0 : serviceDelay + 100;
            }
        </div>
    </div>
</section>
<!-- Service end -->

<!-- About / Skills Section Start -->
<section class="section skills-section border-top border-bottom py-5">
    <div class="container">
        
        <div class="row mb-4">
            <div class="col-12 text-center">
                <h2 class="mb-2">Yetkinliklerimiz</h2>
                <p>Ekibimizin uzmanlık alanları ve yetkinlik seviyeleri</p>
            </div>
        </div>

        <div class="row align-items-center mt-4">
            <!-- Sol Sütun (İlk 4 Yetkinlik) -->
            <div class="col-lg-6 pr-lg-4 mb-4 mb-lg-0">
                <div class="modern-progress-wrapper">
                    @for (int i = 0; i < Math.Min(4, Model.Skills.Count); i++)
                    {
                        var skill = Model.Skills[i];
                        <div class="modern-progress-item">
                            <div class="progress-info-row d-flex align-items-center justify-content-between mb-2">
                                <span class="progress-name">@skill.Name</span>
                                <span class="progress-badge">0%</span>
                            </div>
                            <div class="modern-progress-track">
                                <div class="modern-progress-fill" data-percent="@skill.Percentage" style="width: 0%;" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" aria-label="@skill.Name Yetkinlik Oranı"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Sağ Sütun (Kalan 4 Yetkinlik) -->
            <div class="col-lg-6 pl-lg-4">
                <div class="modern-progress-wrapper">
                    @for (int i = 4; i < Math.Min(8, Model.Skills.Count); i++)
                    {
                        var skill = Model.Skills[i];
                        <div class="modern-progress-item">
                            <div class="progress-info-row d-flex align-items-center justify-content-between mb-2">
                                <span class="progress-name">@skill.Name</span>
                                <span class="progress-badge">0%</span>
                            </div>
                            <div class="modern-progress-track">
                                <div class="modern-progress-fill" data-percent="@skill.Percentage" style="width: 0%;" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" aria-label="@skill.Name Yetkinlik Oranı"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!-- About / Skills Section End -->

<!-- Testimonials Section -->
<section id="testimonials" class="testimonials-section section py-5">
    <!-- Section Header -->
    <div class="container text-center section-header" data-aos="fade-up">
        <h2 class="mt-2 font-weight-bold">@Model.TestimonialsTitle</h2>
        <p>@Model.TestimonialsDescription</p>
    </div>

    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="swiper testimonials-swiper">
            <div class="swiper-wrapper">
                @foreach (var t in Model.Testimonials)
                {
                    <div class="swiper-slide">
                        <div class="testimonial-card-item">
                            <div class="testimonial-card-header">
                                <img src="@t.AvatarUrl" class="testimonial-card-avatar" alt="@t.AuthorName" loading="lazy" decoding="async">
                                <div class="testimonial-card-info">
                                    <h3>@t.AuthorName</h3>
                                    <h4>@t.AuthorRole &bull; @t.Company</h4>
                                </div>
                            </div>
                            <div class="testimonial-card-stars">
                                @for (int i = 0; i < t.Stars; i++)
                                {
                                    <i class="bi bi-star-fill" aria-hidden="true"></i>
                                }
                                @for (int i = t.Stars; i < 5; i++)
                                {
                                    <i class="bi bi-star" aria-hidden="true"></i>
                                }
                            </div>
                            <div class="testimonial-card-body">
                                <p>
                                    <i class="bi bi-quote quote-icon-left" aria-hidden="true"></i>
                                    <span>@t.Quote</span>
                                    <i class="bi bi-quote quote-icon-right" aria-hidden="true"></i>
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <!-- Pagination Dots -->
            <div class="swiper-pagination"></div>
        </div>
    </div>
</section>
<!-- /Testimonials Section -->
